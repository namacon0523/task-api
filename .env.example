# このファイルを .env という名前でコピーして、値を書き換えて使う

# PostgreSQL のユーザー名・パスワード・データベース名
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=<自分で決めたパスワード>
POSTGRES_DB=taskdb

# アプリがデータベースにつなぐための住所（上の3つと同じ値を入れる）
DATABASE_URL=postgres://taskapp:<自分で決めたパスワード>@localhost:5432/taskdb

# テスト用のデータベース（テストのたびに中身を消すので、ふだん用とは分ける）
TEST_DATABASE_URL=postgres://taskapp:<自分で決めたパスワード>@localhost:5432/taskdb_test
